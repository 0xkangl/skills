# =============================================================================
# .env.example — annotated configuration template
# Source of truth: code-conventions skill, configuration.md §3.
#
# Rules:
#   - Commit this file; NEVER commit a real .env. Values here are placeholders.
#   - Tags:  [REQUIRED] startup fails without it
#            [OPTIONAL] safe default shown
#            [COND]     required only when the related feature is enabled
#   - Generate 256-bit secrets with:  openssl rand -hex 32
#   - Keep in sync: add/rename/remove a var here in the SAME change as the code,
#     placed in the correct group + importance order (configuration.md §2, §3).
# Groups are ordered by boot-criticality.
# Select only the groups/keys used by the module. Server signing secrets never
# belong in frontend bundles; existing projects keep their configuration contract.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Runtime
# -----------------------------------------------------------------------------
APP_ENV=development            # [REQUIRED] development | staging | production
PORT=8080                      # [COND] required for an HTTP listener
LOG_FORMAT=json                # [OPTIONAL] json (default) | text (local dev only)
LOG_LEVEL=info                 # [OPTIONAL] debug | info (default) | warn | error
METRICS_PORT=9090              # [OPTIONAL] HTTP services: 9090 = dedicated listener; 0 = /metrics on PORT

# -----------------------------------------------------------------------------
# 2. Data Store
# -----------------------------------------------------------------------------
# [COND] required when using a database; PostgreSQL example, sslmode=require in production
DATABASE_URL=postgres://user:pass@localhost:5432/app?sslmode=disable

# -----------------------------------------------------------------------------
# 3. Security & Secrets   (all via: openssl rand -hex 32 — never log, never commit)
# -----------------------------------------------------------------------------
# [COND] required for TRANSIENT business secrets HKDF-derived per purpose.
#            Short rotation cadence (nothing long-lived depends on it).
APP_PEPPER=

# [COND] required when signing JWTs or verifying locally with this key; DEDICATED.
#        NOT derived from APP_PEPPER.
#            Rotate rarely + with kid overlap (see configuration.md §6.2).
JWT_SIGNING_KEY=

# [COND] required for data encrypted AT REST in the DB. Dedicated + long-lived;
#        rotate only via a re-encryption migration. One per purpose, e.g.:
# PII_ENCRYPTION_KEY=

# [OPTIONAL] token accepted by THIS service via X-Internal-Token.
#            Unset/empty: start normally, keep token-protected internal access disabled.
INTERNAL_TOKEN=

# [COND] required when calling another service's token-protected internal endpoints.
#        Use that service's INTERNAL_TOKEN value; sent via X-Internal-Token, e.g.:
# BILLING_INTERNAL_TOKEN=

# JWT token lifetimes (durations). [OPTIONAL] — defaults shown.
AUTH_ACCESS_TOKEN_TTL=15m          # mobile / native / default access token
AUTH_REFRESH_TOKEN_TTL=30d         # mobile / native refresh token
# Web access inherits the resolved generic access TTL when unset.
# AUTH_WEB_ACCESS_TOKEN_TTL=15m
AUTH_WEB_REFRESH_TOKEN_TTL=7d      # web refresh token; independent default, not inherited

# -----------------------------------------------------------------------------
# 4. Cache / Queue
# -----------------------------------------------------------------------------
# [COND] required when Redis backs cache / session / rate-limit / idempotency
CACHE_REDIS_URL=redis://localhost:6379/0
# Project prefix for shared infra. Empty OK for local single-tenant;
# MUST be set on shared/prod infra. Module prefix is fixed in code (§4).
CACHE_KEY_PREFIX=acme          # [COND]
# [COND] required only for Redis-backed queues; configure independently from cache
QUEUE_REDIS_URL=redis://localhost:6379/1
QUEUE_NAME_PREFIX=acme         # [COND] required when a shared broker is used

# -----------------------------------------------------------------------------
# 5. Localization
# -----------------------------------------------------------------------------
DEFAULT_LOCALE=en              # [COND] localized responses: BCP 47 fallback when Accept-Language absent/unmatched

# -----------------------------------------------------------------------------
# 6. Third-Party Integrations   (provider selection; `stub` is one provider)
# -----------------------------------------------------------------------------
# [OPTIONAL] default `stub` (logs intended calls, no real I/O).
#            staging/prod MUST pick a real impl; APP_ENV=production rejects `stub`.
SMS_PROVIDER=stub              # stub | twilio | ...
# [COND] required when a real impl is selected:
# SMS_API_KEY=
