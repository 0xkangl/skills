# Application
# development | test | staging | production
NODE_ENV=development

# Add module-specific environment variables below
# PORT=
# API_BASE_URL=

# Deployment credentials (local + CI only; never committed, never in wrangler.jsonc)
# wrangler 自动读取这两个变量,CI 里因此无需 wrangler login。
# token 用最小权限(Workers Scripts:Edit + 实际用到的绑定;自定义域再加 Zone->Workers Routes:Edit)。
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_ACCOUNT_ID=

# 运行时配置的归属:非敏感且启动后通常不改 -> wrangler.jsonc 的 vars(入仓);
# 敏感项 -> `wrangler secret put`(本地开发放 .dev.vars,已 gitignore)。
# 判据与发版流程见 `code-conventions` skill 的部署规范。
