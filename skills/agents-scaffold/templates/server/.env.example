# Application
# development | test | staging | production
APP_ENV=development
PORT=8080

# Log level
# Required: yes
# Allowed values: debug | info | warning | error | critical
# Default: info
LOG_LEVEL=info

# Add module-specific environment variables below
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Redis for cache / session / rate-limit / idempotency (only when Redis-backed)
#CACHE_REDIS_URL=redis://localhost:6379/0
# Redis for queues (configure independently, only when Redis-backed)
#QUEUE_REDIS_URL=redis://localhost:6379/1

# Optional: token accepted by this service via X-Internal-Token.
# Unset/empty: start normally, keep token-protected internal access disabled.
INTERNAL_TOKEN=

# Metrics
# Required: no
# Allowed values: 0 | any non-zero port number
# Default: 9090
# When 0: register GET /metrics on the main HTTP server (PORT)
# When non-zero (e.g. 9090): serve /metrics on a dedicated listener at that port
METRICS_PORT=9090

# 部署时这些变量的归属:非敏感且启动后通常不改 -> fly.toml 的 [env](入仓);
# 敏感项(DATABASE_URL / CACHE_REDIS_URL / QUEUE_REDIS_URL / INTERNAL_TOKEN / JWT_SIGNING_KEY / 第三方 key) -> `flyctl secrets set`。
# 判据与发版流程见 `code-conventions` skill 的部署规范。
